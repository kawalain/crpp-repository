// The Mini window: a card with every member's disc, lit while they make a sound, then mute and close. It is the
// whole window, whose size and corners it reports. Nothing here moves, so a disc costs one frame.
let per_row = 5
let cols = min(max(@members, 1), per_row)
let rows = max(1, ceil(@members/per_row))
let width = max(16+cols*52+12, 16+42+12+42+16)
let height = 12+rows*52+54
report width = width
report height = height
report radius = 16
fill @dark ? cloud_base : surface
stroke alpha(hl, 0.35) (0.5, 0.5, @W-1, @H-1) radius 15.5 width 1
repeat @members {
  let dx = 16+(@i-floor(@i/per_row)*per_row)*52
  let dy = 12+floor(@i/per_row)*52
  fill @member_lit ? alpha(hl, 0.45) : hl_pale (dx, dy, 48, 48) ellipse
  picture member (dx+8, dy+8, 32, 32) opacity @member_offline ? 0.55 : 1 gray @muted
}
let bar = height-12-42
use fab(alarmed = @muted) (16, bar, 42, 42) hit mute {
  let ink = @muted ? white : @hot ? hl_text : hl_text_soft
  path "M2.6,9 H5.6 L10.3,5.1 C10.9,4.6 11.8,5 11.8,5.8 V18.2 C11.8,19 10.9,19.4 10.3,18.9 L5.6,15 H2.6 C2,15 1.5,14.5 1.5,13.9 V10.1 C1.5,9.5 2,9 2.6,9 Z"
      (@muted ? 11.5 : 7.6, 9) color ink
  path "M3.2,4.6 L17,18.6" (11.5, 9) color ink width 2.1 if @muted
  path "M14.6,9.2 C15.6,10.9 15.6,13.1 14.6,14.8M17.6,6.6 C19.8,9.9 19.8,14.1 17.6,17.4M21.3,4.2 C24.3,8.8 24.3,15.2 21.3,19.8"
      (7.6, 9) color ink width 2.1 if !@muted
}
use fab (@W-16-42, bar, 42, 42) hit close {
  path "M14 14 28 28M28 14 14 28" color @hot ? hl_text : hl_text_soft width 2.6 caps round
}
