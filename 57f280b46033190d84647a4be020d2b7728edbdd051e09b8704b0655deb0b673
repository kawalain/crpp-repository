let shown = ease(1, 160ms)
let card_w = min(520, @W-40)
let card_h = min(480, @H-60)
let ink = alpha(hl_text, shown)
use modal(card_w = card_w, card_h = card_h, shown = shown, backdrop_hit = hit(backdrop), card_hit = hit(card)) {
  // --cl-bg: color-mix(in srgb, var(--hl) 3%, var(--surface))
  fill alpha(mix(hl, surface, 3%), shown) radius 14
  let pad_x = 28
  let head_top = 22
  let head_w = @W-pad_x-62
  let tagline_h = @has_tagline ? texth(note_title, @tagline, head_w) : 0
  let date_h = @has_date ? texth(note_date, @date, head_w) : 0
  let version_h = @has_version ? texth(note_version, @version, head_w) : 0
  let date_y = head_top+(@has_tagline ? tagline_h+2 : 0)
  let version_y = date_y+(@has_date ? date_h+2 : 0)
  let head_end = version_y+(@has_version ? version_h : (@has_tagline || @has_date ? -2 : 0))
  let head_h = @has_tagline || @has_date || @has_version ? head_end+14 : 0
  text @tr.changelog_failed (pad_x, (@H-27)/2, @W-2*pad_x, 27) style note_failed color ink if !@has_entries
  slot body y head_h h @H-head_h numbers (pad_x, 20, 4, 14, 6, 24, head_h>0 ? 0 : head_top, @W)
      styles (note_heading, note_item) colors (ink, alpha(hl, 0.4))
  text @tagline (pad_x, head_top, head_w, tagline_h) style note_title color ink if @has_tagline
  text @date (pad_x, date_y, head_w, date_h) style note_date color ink if @has_date
  text @version (pad_x, version_y, head_w, version_h) style note_version color alpha(hl_text_soft, shown)
      if @has_version
  // .cl-close
  hit close (@W-16-36, 15, 36, 36) {
    fill alpha(hl_pale2, shown) ellipse if @hot
    path "M12 12 24 24M24 12 12 24" color alpha(hl, shown) width 4.4 caps flat
  }
  // .cl-hint
  let hint = ease(@hint_on, 180ms)
  report hint_left = hint
  if hint>0 {
    let bubble_w = textw(note_hint, @hint, @W)+30
    let text_h = texth(note_hint, @hint, @W)
    ((@W-bubble_w)/2, (@shown_hint<0 ? 14 : @H-14-text_h-10)+4*(1-hint), bubble_w, text_h+10) {
      use bubble(shown = hint)
      text @hint style note_hint color alpha(on_accent, hint) y 5 h text_h
    }
  }
}
