// A code with STAR in it: stars in the sky, behind the cloud.
repeat 5 if @stars {
  let sx = @i==0 ? 0.07 : @i==1 ? 0.2 : @i==2 ? 0.37 : @i==3 ? 0.58 : 0.76
  let sy = @i==0 ? 24 : @i==1 ? 56 : @i==2 ? 16 : @i==3 ? 44 : 20
  let size = @i==1 || @i==3 ? 1.6 : 1.1
  path "M5 0 6.2 3.8 10 5 6.2 6.2 5 10 3.8 6.2 0 5 3.8 3.8Z" (@W*sx, sy) color alpha(white, 0.9) scale size
}
// The Room's weather, from how busy it is: the sky darkens a step at a time, it rains from the third step and
// lightning strikes in a storm. Nothing moves, so a step costs one frame. A light cloud only tints, as the text on
// it is pale: greyed as the sky is, the names and the chat could no longer be read.
let gloom = @weather==1 ? 0.14 : @weather==2 ? 0.26 : 0.4
fill alpha(weather_sky, gloom) if @weather>0
repeat 44 if @weather>=2 {
  let f = @i*0.618034+0.31
  let g = @i*0.4142+0.07
  path "M4 0 0 10" (@W*(f-floor(f)), @H*(g-floor(g))) color alpha(rain, 0.75) width 1.6 caps round
}
path "M14 0 4 16H11L7 30 20 11H13L18 0Z" (@W*0.1, 22) color bolt scale 1.5 if @weather==3
// The cloud, four circles and a rectangle, on the stage. Everything else keeps its size in the window.
