// The code, which grows a little while it has the focus.
let focus = ease(@code_focus, 150ms)
let faint = @dark ? hl_text_soft : alpha(white, 0.85)
(469, 522, 279, 80) scale 1+0.012*focus {
  fill entry radius 18
  field code (18, 10, 205, 60) style code color @dark ? hl_text : on_accent placeholder @tr.home_code_placeholder
      placeholder_style code_placeholder placeholder_color faint caret @dark ? hl_text : on_accent
      selection alpha(hl, 0.4)
  hit code
  hit join (221, 10, 52, 60) {
    let over = ease(@hot, 150ms)
    fill alpha(@dark ? hl_soft : mix(entry, white, 40%), over) radius 13 if over>0
    path "M10 22h23M23 11l11 11-11 11" (10, 14)
        color mix(@dark ? hl_text_dark : hl_text, @dark ? hl_text_soft : faint, over) scale 32/44 width 3
  }
}
// How many public Rooms are open, under the search, when the server said.
text @public_rooms_text (705, 606, 200, 20) style modal_note color alpha(hl_text, 0.85) if @public_rooms>=0
// Public room search. A held Seat lights it.
hit find (759, 522, 92, 80) {
  let over = ease(@hot, 150ms)
  let grow = ease(@hot, 140ms)
  let light = ease(@returning, 150ms)
  let shown = ease(@find_tip, 150ms)
  scale 1+0.05*grow {
    fill mix(hl_dark, mix(hl, entry, light), over) radius 18
    let rest = @dark ? mix(on_accent, hl_text_soft, light) : faint
    let icon = mix(on_accent, rest, over)
    (25, 19, 44, 44) about (25, 19) scale 42/44 {
      stroke icon (8, 8, 22, 22) ellipse width 3.2
      line icon (27.5, 27.5) to (37, 37) width 3.2
    }
    // The label is the button's child, so it grows with it.
    if shown>0 {
      let tip_w = textw(tip, @tr.home_find_public, 600)+30
      use tip(shown = shown) ((@W-tip_w)/2, -40+4*(1-shown), tip_w, 32) text @tr.home_find_public
    }
  }
}
