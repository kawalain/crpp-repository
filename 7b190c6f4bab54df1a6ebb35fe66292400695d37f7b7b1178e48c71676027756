style caption size 13 weight 700 line_height @h ellipsis exact role caption

part button(primary = 0, focused = 0, off = 0) snap w max(75, ceil(textw(button, @label))+24) h 23 {
  fill @pressed && !off ? button_down : button radius 3
  (@u, @u, @W-2*@u, @H-2*@u) if !off && !@pressed && (@hot || primary || focused) {
    fill @hot ? hover_0 : focus_0 h @u
    fill @hot ? hover_1 : focus_2 y @u h @u
    fill @hot ? hover_2 : focus_1 y 2*@u w @u h @H-3*@u
    fill @hot ? hover_2 : focus_1 (@W-@u, 2*@u, @u, @H-3*@u)
    fill @hot ? hover_3 : focus_3 y @H-@u h @u
  }
  stroke off ? edge_dark : button_line radius 3 width @u
  text @label (@u, @u) style button color off_shadow if off
  text @label style button color off_ink if off
  text @label (@pressed ? @u : 0, @pressed ? @u : 0) style button color ink if !off
}

part field(off = 0) {
  fill off ? field_off : field
  frame field_line
}

part check_box(on = 0, off = 0) snap w 13 h 13 {
  (@u, @u, @W-2*@u, @H-2*@u) {
    fill off ? field_off : check_to
    fill check_shade_0 w @W h @u if !off
    fill check_shade_0 w @u h @H if !off
    fill check_shade_1 (@u, @u, @W-@u, @u) if !off
    fill check_shade_1 (@u, @u, @u, @H-@u) if !off
    fill check_shade_2 (2*@u, 2*@u, @W-2*@u, @u) if !off
    fill check_shade_2 (2*@u, 2*@u, @u, @H-2*@u) if !off
  }
  frame off ? edge_dark : check_line
  frame check_hot_0 (@u, @u, @W-2*@u, @H-2*@u) if @hot && !off
  frame check_hot_1 (2*@u, 2*@u, @W-4*@u, @H-4*@u) if @hot && !off
  path "M3.5 6.5 5.5 8.5 9.5 4" color off ? off_ink : tick width 2 caps flat if on
}

part combo_arrow(down = 0) snap {
  fill down ? bar_thumb_low : @hot ? bar_thumb_hot : bar_thumb radius 2
  stroke edge_light radius 2 width @u
  path "M-4 -2H4L0 2.5Z" (@W/2, @H/2, 1, 1) color bar_arrow snap
}

part group_box snap {
  stroke group_line radius 3 width @u
  let legend_w = ceil(textw(body, @label))+6
  fill face (8, -1, legend_w, 3)
  text @label (11, -8, legend_w, 16) style body color legend
}

part scroll_arrow(down = 0) snap {
  fill @pressed ? bar_thumb_low : @hot ? bar_thumb_hot : bar_thumb radius 2
  stroke edge_light radius 2 width @u
  path "M-4 -2H4L0 2.5Z" (@W/2+(@pressed ? @u : 0), @H/2+(@pressed ? @u : 0), 1, 1) color bar_arrow snap if down
  path "M-4 2H4L0 -2.5Z" (@W/2+(@pressed ? @u : 0), @H/2+(@pressed ? @u : 0), 1, 1) color bar_arrow snap if !down
}

part scroll_thumb snap {
  fill @hot ? bar_thumb_hot : bar_thumb radius 2
  stroke edge_light radius 2 width @u
  let mid = snap(@Y+@H/2)-@Y
  repeat 4 {
    fill edge_light (5, mid+(2*@i-3)*@u, @W-10, @u)
    fill bar_thumb_low (5, mid+(2*@i-2)*@u, @W-10, @u)
  }
}

part plain_thumb snap {
  fill bar_thumb radius 2
  stroke edge_light radius 2 width @u
}

part slider(at = 0) {
  let cy = snap(@Y+@H/2)-@Y
  fill track_edge y cy-@u h 1
  fill track y cy h 1
  fill edge_light y cy+@u h 1
  (10.5+(@W-21)*at-5, cy-9, 11, 19) snap {
    fill thumb radius 2
    fill tick (@u, @u, @W-2*@u, 2*@u)
    fill tick (@u, @H-3*@u, @W-2*@u, 2*@u)
    stroke thumb_line radius 2 width @u
  }
}

part progress(percent = 0) {
  y @H/2-7 h 14 snap {
    fill field
    frame progress_line
    let inner = @W-4
    let filled = inner*percent/100
    repeat min(floor(filled/10)+1, ceil(inner/10)) {
      fill progress (2+@i*10, 2, min(8, inner-@i*10), @H-4) snap
    }
  }
}

part panel_list {
  fill field
  frame list_line
}

part panel_menu {
  fill menu_shadow (2, 2)
  fill menu
  frame menu_line
}

part panel_popup snap {
  fill face
  frame edge_out
  fill edge_light (@u, @u, @W-2*@u, @u)
  fill edge_light (@u, @u, @u, @H-2*@u)
  fill edge_dark (@u, @H-2*@u, @W-2*@u, @u)
  fill edge_dark (@W-2*@u, @u, @u, @H-2*@u)
}

part panel_info {
  fill info
  frame info_line
}

part caption_button(is_close = 0) snap {
  fill is_close ? close_down : minimize_down radius 3 if @pressed
  fill is_close ? (@hot ? close_hot : close) : (@hot ? caption_button_hot : caption_button) radius 3 if !@pressed
  stroke caption_ink radius 3 width @u
  line caption_ink (@W*0.3, @W*0.3) to (@W-@W*0.3, @H-@W*0.3) width 2 if is_close
  line caption_ink (@W-@W*0.3, @W*0.3) to (@W*0.3, @H-@W*0.3) width 2 if is_close
  fill caption_ink (@W*0.25, @H-@H*0.34, @W*0.38, 3) if !is_close
}
