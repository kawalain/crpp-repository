style bold_center size @font_size weight 700 line_height @h align center ellipsis exact
style button size @font_size line_height @h align center ellipsis exact
style paragraph size @font_size line_height @font_size+4 wrap exact keep_words
style chat_text size @font_size line_height @font_size+4 wrap exact
style paragraph_center size @font_size line_height @font_size+4 align center wrap exact
style tip_line size @font_size line_height 16 exact
style note_title size @font_size+2 weight 700 line_height @font_size+4 wrap exact
style note_version size @font_size line_height 20 exact
style title size @font_size+2 weight 700 line_height @h ellipsis exact
