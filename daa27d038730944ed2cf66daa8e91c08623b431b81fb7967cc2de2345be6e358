// The look of the time is two lines of light from the top left and two of shade from the bottom right.
part bevel(top_out = 0, low_out = 0, top_in = 0, low_in = 0) snap {
  fill low_out y @H-@u h @u
  fill low_out x @W-@u w @u
  fill top_out w @W-@u h @u
  fill top_out w @u h @H-@u
  fill low_in (@u, @H-2*@u, @W-2*@u, @u)
  fill low_in (@W-2*@u, @u, @u, @H-2*@u)
  fill top_in (@u, @u, @W-3*@u, @u)
  fill top_in (@u, @u, @u, @H-3*@u)
}

part raised {
  use bevel(top_out = edge_light, low_out = edge_out, top_in = edge_soft, low_in = edge_dark)
}

part sunken {
  use bevel(top_out = edge_dark, low_out = edge_light, top_in = edge_out, low_in = edge_soft)
}

part button(primary = 0, focused = 0, off = 0) snap w max(75, ceil(textw(button, @label))+24) h 23 {
  fill face
  use bevel(top_out = edge_out, low_out = edge_light, top_in = edge_dark, low_in = edge_soft) if @pressed && !off
  frame edge_out if (!@pressed || off) && (primary || focused) && !off
  use raised (@u, @u, @W-2*@u, @H-2*@u) if (!@pressed || off) && (primary || focused) && !off
  use raised if (!@pressed || off) && !(primary || focused) || off
  text @label (@u, @u) style button color off_shadow if off
  text @label style button color off_ink if off
  text @label (@pressed ? @u : 0, @pressed ? @u : 0) style button color ink if !off
}

part toolbar_button(lit = 0) snap h 24 w ceil(textw(body, @label))+32 {
  fill toolbar_down if @pressed || lit
  if @hot || @pressed || lit {
    fill @pressed || lit ? edge_dark : edge_light h @u
    fill @pressed || lit ? edge_dark : edge_light w @u
    fill @pressed || lit ? edge_light : edge_dark y @H-@u h @u
    fill @pressed || lit ? edge_light : edge_dark x @W-@u w @u
  }
  text @label style body color ink x 24+(@pressed ? @u : 0) y @pressed ? @u : 0 w @W-28
}

part field(off = 0) {
  fill off ? field_off : field
  use sunken
}

part check_box(on = 0, off = 0) snap w 13 h 13 {
  fill off || (@hot && @pressed) ? field_off : field
  use sunken
  path "M3.5 6.5 5.5 8.5 9.5 4" color off ? off_ink : tick width 2 caps flat if on
}

part combo_arrow(down = 0) snap {
  fill face
  frame edge_dark if down
  use raised if !down
  path "M-4 -2H4L0 2.5Z" (@W/2+(down ? @u : 0), @H/2+(down ? @u : 0), 1, 1) color bar_arrow snap
}

part dropdown(open = 0, off = 0) {
  use field(off = off)
  text @label style body color off ? off_ink : ink x 4 w @W-24
  use combo_arrow(down = open) (@W-17, 2, 15, @H-4)
}

part picture_frame(glow = 0) snap {
  frame glow_2 (-3*@u, -3*@u, @W+6*@u, @H+6*@u) alpha glow if glow > 0
  frame glow_1 (-2*@u, -2*@u, @W+4*@u, @H+4*@u) alpha glow if glow > 0
  frame glow_0 (-@u, -@u, @W+2*@u, @H+2*@u) alpha glow if glow > 0
  fill field
  frame picture_line
}

part group_box snap {
  frame edge_dark w @W-@u h @H-@u
  frame edge_light (@u, @u, @W-@u, @H-@u)
  let legend_w = ceil(textw(body, @label))+6
  fill face (8, -1, legend_w, 3)
  text @label (11, -8, legend_w, 16) style body color ink
}

part link {
  text @label style body color link
  fill link y floor(@Y+@H/2+@font_size/2)-@Y w textw(body, @label) h 1 if @hot
}

part scroll_arrow(down = 0) snap {
  fill face
  frame edge_dark if @pressed
  use raised if !@pressed
  path "M-4 -2H4L0 2.5Z" (@W/2+(@pressed ? @u : 0), @H/2+(@pressed ? @u : 0), 1, 1) color bar_arrow snap if down
  path "M-4 2H4L0 -2.5Z" (@W/2+(@pressed ? @u : 0), @H/2+(@pressed ? @u : 0), 1, 1) color bar_arrow snap if !down
}

part scroll_thumb snap {
  fill face
  use raised
}

part scrollbar(view = 0, content = 0, offset = 0, up = -1, down = -1, track_hit = -1, thumb_hit = -1, track_note = -1) {
  let arrow_h = min(@W, @H/2)
  let track_h = @H-2*arrow_h
  let room = content>view ? content-view : 0
  let thumb_h = content>0 ? max(16, floor(track_h*min(1, view/content))) : track_h
  let thumb_y = arrow_h+(room>0 ? floor((track_h-thumb_h)*offset/room) : 0)
  fill bar_track_from y arrow_h h track_h note_by track_note
  hit_by track_hit
  use scroll_arrow hit_by up h arrow_h
  use scroll_arrow(down = 1) hit_by down y @H-arrow_h h arrow_h
  hit_by thumb_hit y thumb_y h thumb_h {
    use scroll_thumb if track_h>=16 && thumb_h<track_h
  }
}

part check_row(on = 0, off = 0, pinned = 0) {
  use check_box(on = on, off = off) y 5
  text @label style body color off ? off_ink : ink x 18 w @W-30
  fill link (@W-7, 9, 6, 6) if pinned
}

part plain_thumb snap {
  fill face
  use raised
}

part slider(at = 0) {
  let cy = snap(@Y+@H/2)-@Y
  fill edge_dark y cy-@u h 1
  fill edge_out y cy h 1
  fill edge_light y cy+@u h 1
  (10.5+(@W-21)*at-5, cy-9, 11, 19) snap {
    fill face
    use raised
  }
}

part switch(on = 0, off = 0) {
  use check_box(on = on, off = off) y floor(@Y+(@H-13)/2)-@Y
}

part progress(percent = 0) {
  y @H/2-7 h 14 snap {
    fill face
    use sunken
    let inner = @W-4
    let filled = inner*percent/100
    repeat min(floor(filled/10)+1, ceil(inner/10)) {
      fill progress (2+@i*10, 2, min(8, inner-@i*10), @H-4) snap
    }
  }
}

part bubble snap {
  fill tooltip
  frame tooltip_line
}

part cell(selected = 0) {
  fill hl_soft if selected
  frame select if selected || @hot
}

part list_item(selected = 0) {
  fill select if selected || @hot
  text @label style body color selected || @hot ? select_ink : ink x 3 w @W-6
}

// The name of what follows, then a line.
part list_heading {
  let tw = min(textw(body, @label), @W-6-16)
  text @label style body color ink_soft x 3 w tw
  fill alpha(ink_soft, 0.5) (3+tw+4, floor(@Y+@H/2+0.5)-@Y, @W-3-(3+tw+4), 1)
}

part menu_item(active = 0, off = 0) {
  fill select if @hot
  text @label style body color off ? off_ink : @hot ? select_ink : ink x 20 w @W-24
  path "M3.5 6.5 5.5 8.5 9.5 4" (2, round(@Y+(@H-13)/2)-@Y) color off ? off_ink : @hot ? select_ink : ink width 2
      caps flat if active
}

part panel_modal {
  fill face
}

part panel_list {
  fill field
  use sunken
}

part panel_menu snap {
  fill menu
  use raised
}

part panel_popup snap {
  fill face
  use raised
}

part panel_info snap {
  fill face
  use raised
}

part form_group height rows.bottom+20 {
  column id rows x 12 y 14 w @W-24 {
    content
  }
  use group_box text @label x 2 w @W-4 h rows.bottom+6
}

part form_check(on = 0, off = 0) h row_h {
  use check_box(on = on, off = off) y 3
  text @label style body color off ? off_ink : ink x 18 w @W-18
}

part form_text h texth(paragraph, @label, @W) {
  text @label style paragraph color ink_soft
}

part form_hint h texth(paragraph, @label, @W-18) {
  text @label style paragraph color ink_soft
}

part form_combo h field_h {
  let list_w = min(170, floor(@W*0.55))
  text @label style body color ink w @W-list_w-6
  x @W-list_w w list_w {
    content
  }
}

part form_slider(at = 0, list = 0, own = -1, where = -1) h 18+field_h {
  text @label style body color ink h 16
  let list_w = list ? floor(@W*0.52) : 0
  use slider(at = at) hit_by own note_by where y 18 w @W-(list ? list_w+8 : 0) h field_h
  (@W-list_w, 18, list_w, field_h) if list {
    content
  }
}

part options_tab(active = 0) {
  fill select if active
  fill hl_pale2 if !active && @hot
  text @label style body color active ? select_ink : ink x 6 w @W-12
}

part frame_ring(at = 0, thick = 0, top = 0, left = 0, right = 0, bottom = 0) {
  fill left (at, top, thick, @H-top-at)
  fill right (@W-at-thick, top, thick, @H-top-at)
  fill bottom (at, @H-at-thick, @W-2*at, thick)
}

part menu_title(open = 0) w ceil(textw(body_center, @label))+14 h menu_h-1 {
  fill select if open || @hot
  text @label style body_center color open || @hot ? select_ink : ink
}

part caption_button(is_close = 0) snap {
  fill face
  use bevel(top_out = edge_out, low_out = edge_light, top_in = edge_dark, low_in = edge_soft) if @pressed
  use raised if !@pressed
  line ink (@W*0.3+(@pressed ? @u : 0), @W*0.3+(@pressed ? @u : 0))
      to (@W-@W*0.3+(@pressed ? @u : 0), @H-@W*0.3+(@pressed ? @u : 0)) width 2 if is_close
  line ink (@W-@W*0.3+(@pressed ? @u : 0), @W*0.3+(@pressed ? @u : 0))
      to (@W*0.3+(@pressed ? @u : 0), @H-@W*0.3+(@pressed ? @u : 0)) width 2 if is_close
  fill ink (@W*0.25+(@pressed ? @u : 0), @H-@H*0.34+(@pressed ? @u : 0), @W*0.38, 2) if !is_close
}

