// One drop of the droplet's splash: thrown towards (dx, dy) from where its box starts, it falls and fades as t
// runs to 1.
part splash_drop(dx = 0, dy = 0, t = 0, size = 0.25) {
  let out = 1-(1-t)*(1-t)
  (dx*out-18*size, dy*out+90*t*t-25*size) opacity 1-t*t {
    path "M18 1C13 10 2 20 2 31a16 16 0 0 0 32 0C34 20 23 10 18 1Z" color droplet scale size
  }
}

// .tip: its box is the label's own, and it rises 4 px as it fades in.
// Where the keyboard is. The program draws it over the control, in the control's box, as a browser draws
// its outline, and only while that shows.
part focus_ring {
  stroke ink_strong (-3, -3, @W+6, @H+6) radius min(@H/2+3, 13) width 2
}

part tip(shown = 1) {
  fill alpha(hl, shown) radius 11
  text @label (15, 5, @W-29, 22) style tip color alpha(on_accent, shown)
}

// .modal-backdrop's fade is a little shorter than the card's rise.
part backdrop(shown = 1) {
  fill alpha(backdrop, 0.34*min(1, shown*160/140))
}

// .modal-backdrop and .modal-card, in the window. What is in it goes in its box, and it rises 6 px.
part modal(card_w = 320, card_h = 100, shown = 1, backdrop_hit = -1, card_hit = -1) {
  use backdrop(shown = shown)
  hit_by backdrop_hit
  let left = (@W-card_w)/2
  let top = (@H-card_h)/2+6*(1-shown)
  shadow alpha(panel_shadow, (@dark ? 0.33 : 0.22)*shown) (left, top, card_w, card_h) radius 14 blur @dark ? 38 : 16
      dy @dark ? 12 : 4
  fill alpha(surface, shown) (left, top, card_w, card_h) radius 14
  (left, (@H-card_h)/2, card_w, card_h) hit_by card_hit
  (left, top, card_w, card_h) {
    content
  }
}

// A panel whose shadow follows the dark Theme, as upstream's CSS has .modal-card and its lists.
part panel_list(shown = 1) {
  shadow alpha(panel_shadow, (@dark ? 0.33 : 0.22)*shown) radius 14 blur @dark ? 38 : 16 dy @dark ? 12 : 4
  fill alpha(surface, shown) radius 14
}

// A message that floats over a screen.
part bubble(shown = 1) {
  fill alpha(hl, shown) radius 11
}

// One that keeps the light Theme's shadow in the dark one.
part panel_info(shown = 1) {
  shadow alpha(info_shadow, 0.22*shown) radius 14 blur 16 dy 4
  fill alpha(surface, shown) radius 14
}

// .modal-confirm when primary, else .modal-cancel; other sizes for .update-button and a toast's.
part button(primary = 1, shown = 1, radius = 10, grow = 1.04, size = 16) {
  scale @hot ? grow : 1 {
    fill alpha(primary ? (@hot ? hl_dark : hl) : (@hot ? hl_soft : hl_pale2), shown) radius radius
    text @label style button size size line_height @H color alpha(primary || @hot ? on_accent : hl_text, shown)
  }
}

part notice_button(primary = 1) {
  fill @hot ? hl_dark : hl radius @H/2 if primary
  fill hl_pale radius @H/2 if !primary && @hot
  text @label style notice_label line_height @H color primary ? on_accent : ink_strong
}

part prompt_button {
  scale @hot ? 1.03 : 1 {
    fill @hot ? hl_dark : hl radius 10
    text @label style prompt_button color on_accent y 8 h 20
  }
}

// The accent color is the sky's, so both parts are drawn in the surface color.
part progress(percent = 0) {
  fill alpha(surface, 0.35) radius 4
  fill surface radius 4 w max(@H, @W*percent/100)
}

part dropdown(open = 0, off = 0) {
  let a = off ? 0.5 : 1
  fill alpha(open ? hl_soft : @hot ? hl_dark : hl, a) radius 10
  text @label style dropdown line_height @H color alpha(on_accent, a) x 12 w @W-48
  let cx = @W-13-7
  let cy = @H/2
  line alpha(white, a) (cx-6, cy-3) to (cx, cy+3) width 2
  line alpha(white, a) (cx, cy+3) to (cx+6, cy-3) width 2
}

part settings_tab(active = 0) {
  let lit_up = ease(active, 150ms) first jump
  let over = ease(@hot, 150ms) first jump
  let grow = ease(@hot, 140ms) first jump
  let lit = max(lit_up, over)
  scale 1+0.04*grow {
    fill alpha(mix(hl, hl_soft, lit_up), lit) radius 9 if lit>0
    text @label style settings_tab_active color mix(on_accent, hl_text_soft, lit) x 10 w @W-20 if active
    text @label style settings_tab color mix(on_accent, hl_text_soft, lit) x 10 w @W-20 if !active
  }
}

// .toggle-row: only the switch is clickable.
part toggle(on = 0, hit = -1) {
  text @label style row color hl_text w @W-50-16
  (@W-50, 5, 50, 26) hit_by hit {
    let at = ease(on, 160ms) first jump
    let shade = ease(@hot, 150ms) first jump
    fill mix(hl, @dark ? hl_pale2 : toggle_off, at) radius 13
    fill alpha(black, 0.05*shade) radius 13 if shade>0
    let cx = 13+24*at
    // box-shadow: 0 1px 3px
    fill alpha(knob_shadow, 0.33*0.5) (cx-11, 3, 22, 22) ellipse
    fill alpha(knob_shadow, 0.33) (cx-10.5, 3.5, 21, 21) ellipse
    fill @dark ? mix(on_accent, hl_text_soft, at) : surface (cx-10, 3, 20, 20) ellipse
  }
}

part switch(on = 0, off = 0, ms = 160) {
  let a = off ? 0.5 : 1
  let at = ease(on, ms) first jump
  let track = on ? hl : (@dark ? hl_pale2 : switch_off)
  fill alpha(@hot && !off ? mix(black, track, 5%) : track, a) radius 14
  fill alpha(@dark ? (on ? on_accent : hl_text_soft) : surface, a) (3+(@W-@H)*at, 3, @H-6, @H-6) ellipse
}

part slider(at = 0) {
  let pos = slider_thumb/2+(@W-slider_thumb)*at
  fill hl_pale2 radius 3 y @H/2-3 h 6
  fill hl radius 3 y @H/2-3 w pos h 6
  fill hl (pos-slider_thumb/2, @H/2-slider_thumb/2, slider_thumb, slider_thumb) ellipse
  fill @dark ? hl_text_dark : surface (pos-slider_thumb/2+2, @H/2-slider_thumb/2+2, slider_thumb-4, slider_thumb-4)
      ellipse
}

// .open-logs and .reset-settings: filled, grows a little under the pointer.
part text_button {
  let over = ease(@hot, 150ms) first jump
  scale 1+(1.03-1)*over {
    fill mix(hl_dark, hl, over) radius 8
    text @label style text_button line_height @H color on_accent
  }
}

// .account-buttons
part account_button {
  scale @hot ? 1.03 : 1 {
    fill @hot ? hl_dark : hl radius 8
    text @label style account_button line_height @H color on_accent
  }
}

// .person: a head and a body, in its box of 46 by 62.
part person(a = 1, marked = 0) {
  let ink = alpha(hl, a)
  fill ink ellipse x 9 w 28 h 28
  path "M0 23A23 23 0 0 1 46 23V33A4 4 0 0 1 42 37H4A4 4 0 0 1 0 33Z" color ink y 25
  text @tr.sound_me style person_me color alpha(on_accent, a) y 36 h 20 if marked
}

// .fab, and what is in it in the middle of its box of 42.
part fab(alarmed = 0) {
  scale @hot ? 1.08 : 1 {
    shadow alpha(fab_shadow, 0.16) radius 21 blur 8 dy 2
    fill alarmed ? alarm : @dark ? cloud_base : surface radius 21
    content
  }
}

// chosen: the item the keys are on, which looks as one under the pointer does.
part menu_item(active = 0, off = 0, chosen = 0, key = -1) {
  fill active ? (@hot ? hl_dark : hl) : hl_soft radius 9 if active || @hot || chosen
  text @label (12, 8, @W-24, 22) style menu_item color alpha(active || @hot || chosen ? on_accent : hl_text, off ? 0.45 : 1)
      underline key
}

part cell(selected = 0) {
  fill hl_soft radius 10 if selected
  fill hl_pale2 radius 10 if !selected && @hot
}

// li: padding 9 12, 20 tall.
part list_item(selected = 0) {
  fill hl radius 9 if selected
  fill hl_soft radius 9 if !selected && @hot
  text @label (12, 9, @W-24, 20) style list_item_selected color on_accent if selected
  text @label (12, 9, @W-24, 20) style list_item color @hot ? on_accent : hl_text if !selected
}

// Not upstream's: the name of what follows, between lines.
part list_heading {
  let tw = min(textw(list_heading, @label), @W-24-56)
  let mid = floor(@Y+@H/2+0.5)-@Y
  fill alpha(hl_text, 0.3) (12, mid, @W/2-tw/2-10-12, 1)
  fill alpha(hl_text, 0.3) (@W/2+tw/2+10, mid, @W/2-tw/2-10-12, 1)
  text @label (@W/2-tw/2, (@H-20)/2, tw, 20) style list_heading color alpha(hl_text, 0.75)
}
