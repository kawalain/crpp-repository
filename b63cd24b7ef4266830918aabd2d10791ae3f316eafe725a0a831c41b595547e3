let cap = snap(caption_h)
let band = snap(frame_w)
// The region keeps every pixel the curve touches. Those it only partly covers are blended with this, since a window cannot blend with what is behind it.
fill @active ? matte : matte_idle w window_radius+1 h window_radius+1
fill @active ? matte : matte_idle x @W-window_radius-1 w window_radius+2 h window_radius+1
clip h cap {
  fill @active ? caption : caption_idle radius window_radius h cap+2*window_radius down_to cap
}
use frame_ring(at = 2*@u, thick = band-2*@u, top = cap, left = @active ? frame_in : frame_idle, right = @active ? frame_low_in : frame_idle, bottom = @active ? frame_low_in : frame_idle)
use frame_ring(at = @u, thick = @u, top = cap, left = @active ? frame_mid : frame_idle, right = @active ? frame_low_mid : frame_idle, bottom = @active ? frame_low_mid : frame_idle)
use frame_ring(at = 0, thick = @u, top = cap, left = @active ? frame_out : frame_idle, right = @active ? frame_low_out : frame_idle, bottom = @active ? frame_low_out : frame_idle)
picture droplet (8, 6, 16, 16)
let button_left = @W-frame_button_right-frame_button
let minimize_left = button_left-frame_button-frame_button_gap
let title_end = @minimize ? minimize_left : @close ? button_left : @W
text @title (29, 1, max(0, title_end-32), caption_h) style caption color caption_shadow
text @title style caption color caption_ink x 28 w max(0, title_end-32) h caption_h
use caption_button (minimize_left, frame_button_top, frame_button, frame_button) hit minimize if @minimize
use caption_button(is_close = 1) (button_left, frame_button_top, frame_button, frame_button) hit close if @close
(frame_w, caption_h, @W-2*frame_w, menu_h) if @menu_shown {
  fill face
  fill edge_dark y @H-1 h 1
  use menu_title(open = @open_menu==0) id one text @tr.menu_file hit menu hit_index 0 note menu_0
  use menu_title(open = @open_menu==1) id two text @tr.menu_tools hit menu hit_index 1 note menu_1 x one.right
  use menu_title(open = @open_menu==2) text @tr.menu_help hit menu hit_index 2 note menu_2 x two.right
}
